// LIVE in the top bar: Battle Live, a vertical (9:16) livestream for
// TikTok with phone cameras. The panel shows the QR code for each phone,
// the mode (Solo or B2B), the DJs' names, where to send it (the TikTok
// stream key, a recording, or both), and a preview of what the audience
// sees. openDJ's own screen never changes: only the stream gets the
// picture with the cameras.
import { Theme, EdgeLine } from "theme.slint";
import { Switch } from "preferences.slint";

export global LiveUi {
    // The camera server is running (the panel was opened).
    in property <bool> started;
    // Sending or recording now, for how long, and how it's going.
    in property <bool> on-air;
    in property <string> time;
    in property <string> health;
    in property <string> error;
    // No ffmpeg on this computer: how to get it.
    in property <bool> ffmpeg-missing;
    // B2B (two DJs) or Solo.
    in property <bool> b2b: true;
    in property <string> dj-a: "DJ A";
    in property <string> dj-b: "DJ B";
    // Seconds or bars between shots when nothing happens.
    in property <int> rotate-bars: 16;
    // The phones' QR codes and how each camera is doing.
    in property <image> qr1;
    in property <image> qr2;
    in property <string> url1;
    in property <string> url2;
    in property <bool> cam1-live;
    in property <bool> cam2-live;
    in property <string> cam1-status;
    in property <string> cam2-status;
    // The picture the audience sees, a few times a second.
    in property <image> preview;
    // The shot now, as words, and the one picked by hand (-1 automatic).
    in property <string> shot;
    in property <int> manual: -1;
    // Where it goes.
    in property <bool> stream: true;
    in property <bool> record: true;
    in property <bool> projector-open: false;
    // 0 = TikTok, 1 = Instagram, 2 = YouTube
    in-out property <int> platform: 0;
    // 0 = 9:16 (Vertical), 1 = 16:9 (Horizontal)
    in-out property <int> orientation: 0;
    in property <string> server;
    in property <string> key;
    in property <string> key-status: "";
    in property <string> record-folder;
    // B2B Online Remote
    // 0 = Local, 1 = Host (aguardando convidado), 2 = Guest (digitando código), 3 = Conectado, 4 = Procurando (auto-descoberta)
    in-out property <int> b2b-online-state: 0;
    in property <string> b2b-room-code;
    in property <string> b2b-public-ip;
    in-out property <string> b2b-join-code;
    in property <string> b2b-guest-name;
    // 0 = Deck A, 1 = Deck B
    in property <int> b2b-own-deck: 0;
    callback b2b-create-room();
    callback b2b-join-room(string);
    callback b2b-copy-code();
    callback b2b-cancel();
    callback b2b-set-own-deck(int);
    callback b2b-join-direct(string);
    in-out property <string> b2b-host-ip;
    in property <bool> b2b-discovery-failed: false;
    // Licença & Ativação Comercial
    in property <string> license-machine-id: "";
    in property <string> license-status-text: "";
    in property <bool> license-active: false;
    in-out property <string> license-input-key: "";
    in property <string> license-feedback-msg: "";
    callback license-copy-machine-id();
    callback license-validate-key(string);
    callback opened();
    callback toggle-projector();
    callback paste-key();
    callback set-b2b(bool);
    callback set-names(string, string);
    callback set-rotate(int);
    callback set-stream(bool);
    callback set-platform(int);
    callback set-orientation(int);
    callback set-record(bool);
    callback set-server(string);
    callback set-key(string);
    // -1 automatic; B2B: 0 DJ A, 1 DJ B, 2 both; Solo: 0 face, 1 hands.
    callback pick(int);
    callback go();
    callback stop();
    // Switch the cameras off and close the server.
    callback finish();
}

component LiveIcon inherits Path {
    in property <color> ink;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: ink;
    stroke-width: 2px;
    stroke-line-cap: round;
    fill: transparent;
    // A phone on its side with a record dot: a vertical stream.
    commands: "M 8 2.5 L 16 2.5 A 2 2 0 0 1 18 4.5 L 18 19.5 A 2 2 0 0 1 16 21.5 L 8 21.5 A 2 2 0 0 1 6 19.5 L 6 4.5 A 2 2 0 0 1 8 2.5 Z M 10.5 12 A 1.5 1.5 0 1 0 13.5 12 A 1.5 1.5 0 1 0 10.5 12";
}

component Choice inherits Rectangle {
    in property <[string]> choices;
    in property <int> chosen;
    callback picked(index: int);
    height: 26px;
    border-radius: Theme.radius;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for c[i] in choices: Rectangle {
            border-radius: Theme.radius - 2px;
            background: i == chosen ? Theme.n-3a3a3d : cta.has-hover ? Theme.n-222225 : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text { text: c; color: i == chosen ? Theme.text : Theme.text-dim; font-size: 11px; font-weight: i == chosen ? 600 : 400; vertical-alignment: center; horizontal-alignment: center; }
            }
            cta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

component Field inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> secret;
    callback edited(string);
    height: 26px;
    border-radius: Theme.radius;
    background: Theme.well;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.separator;
    if input.text == "": Text {
        x: 8px;
        text: placeholder;
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        input-type: secret ? InputType.password : InputType.text;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
    }
}

component Action inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.accent;
    in property <bool> filled: true;
    in property <length> font-size: 12px;
    callback clicked();
    height: 30px;
    border-radius: 8px;
    background: filled ? (ata.pressed ? tint.darker(0.2) : ata.has-hover ? tint.brighter(0.1) : tint) : (ata.has-hover ? Theme.n-2e2e32 : Theme.control);
    border-width: filled ? 0px : 1px;
    border-color: Theme.border;
    Text { text: label; color: filled ? #14101f : Theme.text; font-size: root.font-size; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    ata := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Label inherits Text {
    color: Theme.text-dim;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// A phone's QR code and how its camera is doing.
component CameraCard inherits VerticalLayout {
    in property <string> title;
    in property <image> qr;
    in property <string> url;
    in property <bool> live;
    in property <string> status;
    spacing: 3px;
    HorizontalLayout {
        spacing: 5px;
        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: live ? Theme.automix : Theme.n-48484c;
        }
        Text { text: title; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
    Rectangle {
        width: 100px;
        height: 100px;
        border-radius: 6px;
        background: Theme.n-ffffff;
        clip: true;
        Image { source: qr; width: 100px; height: 100px; image-rendering: pixelated; }
    }
    Text { text: status; color: live ? Theme.automix : Theme.text-dim; font-size: 10px; width: 100px; wrap: word-wrap; }
}

export component LivePanel inherits PopupWindow {
    width: 630px;
    property <bool> show-license: false;
    close-policy: close-on-click-outside;
    Rectangle {
        background: Theme.panel-raised;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.s-000000b0;
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            HorizontalLayout {
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text { text: "Battle Live"; color: Theme.text; font-size: 15px; font-weight: 700; }
                    Text {
                        text: (LiveUi.orientation == 1 ? "Live horizontal (16:9)" : "Live vertical (9:16)") + " no " + (LiveUi.platform == 2 ? "YouTube" : LiveUi.platform == 1 ? "Instagram" : "TikTok") + " com celulares.";
                        color: Theme.text-dim;
                        font-size: 10px;
                    }
                }
                Action {
                    width: 100px;
                    height: 26px;
                    font-size: 11px;
                    label: "✕ Fechar painel";
                    filled: false;
                    clicked => { root.close(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Choice {
                    choices: ["Solo · 1 DJ", "B2B · 2 DJs"];
                    chosen: LiveUi.b2b ? 1 : 0;
                    picked(i) => { LiveUi.set-b2b(i == 1); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // ── B2B ONLINE REMOTO ──────────────────────────────────────────
            if LiveUi.b2b: VerticalLayout {
                spacing: 8px;
                EdgeLine { line-color: Theme.border; }
                // Cabeçalho com status
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "B2B ONLINE"; vertical-alignment: center; }
                    Rectangle {
                        width: 8px; height: 8px;
                        border-radius: 4px;
                        background: LiveUi.b2b-online-state == 3 ? Theme.automix : Theme.n-48484c;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: LiveUi.b2b-online-state == 1 ? "Aguardando convidado…" :
                              LiveUi.b2b-online-state == 2 ? "Digitando código…" :
                              LiveUi.b2b-online-state == 3 ? "Conectado · " + LiveUi.b2b-guest-name :
                              LiveUi.b2b-online-state == 4 ? "Procurando na rede…" : "";
                        color: Theme.text-dim; font-size: 11px; vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // ESTADO 0: botões iniciais
                if LiveUi.b2b-online-state == 0: HorizontalLayout {
                    spacing: 8px;
                    Action {
                        horizontal-stretch: 1;
                        label: "Criar Sala";
                        filled: false;
                        clicked => { LiveUi.b2b-create-room(); }
                    }
                    Action {
                        horizontal-stretch: 1;
                        label: "Entrar com Código";
                        filled: false;
                        clicked => { LiveUi.b2b-online-state = 2; }
                    }
                }
                // ESTADO 1: anfitrião — mostra o código e botão Copiar
                if LiveUi.b2b-online-state == 1: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Envie o código abaixo para o outro DJ pelo WhatsApp ou chat:";
                        color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.control;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                text: LiveUi.b2b-room-code;
                                color: Theme.text;
                                font-size: 22px;
                                font-weight: 700;
                                letter-spacing: 6px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Action {
                            width: 72px;
                            label: "Copiar";
                            filled: false;
                            clicked => { LiveUi.b2b-copy-code(); }
                        }
                    }
                    if LiveUi.b2b-public-ip != "": Text {
                        text: "Conexão pela Internet: " + LiveUi.b2b-public-ip;
                        color: Theme.accent; font-size: 11px; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "MEU DECK"; vertical-alignment: center; }
                        Choice {
                            choices: ["Deck A", "Deck B"];
                            chosen: LiveUi.b2b-own-deck;
                            picked(i) => { LiveUi.b2b-set-own-deck(i); }
                        }
                    }
                    Action {
                        label: "Cancelar";
                        filled: false;
                        clicked => { LiveUi.b2b-cancel(); }
                    }
                }
                // ESTADO 2: convidado — digita o código
                if LiveUi.b2b-online-state == 2: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Digite o código enviado pelo outro DJ:";
                        color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
                    }
                    join-field := Field {
                        text: LiveUi.b2b-join-code;
                        placeholder: "Código (ex: 7842) ou IP para internet";
                        edited(t) => { LiveUi.b2b-join-code = t; }
                    }
                    if LiveUi.b2b-discovery-failed: VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Não encontrou na rede local. Peça o IP ao anfitrião:";
                            color: Theme.c-e5484d; font-size: 11px; wrap: word-wrap;
                        }
                        Field {
                            text: LiveUi.b2b-host-ip;
                            placeholder: "Ex: 192.168.1.42";
                            edited(t) => { LiveUi.b2b-host-ip = t; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Action {
                            horizontal-stretch: 1;
                            label: LiveUi.b2b-discovery-failed ? "Tentar de Novo" : "Conectar";
                            tint: Theme.automix;
                            clicked => { LiveUi.b2b-join-room(join-field.text); }
                        }
                        if LiveUi.b2b-discovery-failed: Action {
                            horizontal-stretch: 1;
                            label: "Conectar pelo IP";
                            filled: false;
                            clicked => { LiveUi.b2b-join-direct(LiveUi.b2b-host-ip); }
                        }
                        Action {
                            width: 80px;
                            label: "Cancelar";
                            filled: false;
                            clicked => { LiveUi.b2b-cancel(); }
                        }
                    }
                }
                // ESTADO 4: procurando anfitrião na rede local
                if LiveUi.b2b-online-state == 4: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Procurando o anfitrião na rede local…";
                        color: Theme.text; font-size: 12px; wrap: word-wrap;
                    }
                    Text {
                        text: "Verifique se ambos estão na mesma rede Wi-Fi.";
                        color: Theme.text-dim; font-size: 10px; wrap: word-wrap;
                    }
                    Action {
                        label: "Cancelar";
                        filled: false;
                        clicked => { LiveUi.b2b-cancel(); }
                    }
                }
                // ESTADO 3: conectado
                if LiveUi.b2b-online-state == 3: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "MEU DECK"; vertical-alignment: center; }
                        Choice {
                            choices: ["Deck A", "Deck B"];
                            chosen: LiveUi.b2b-own-deck;
                            picked(i) => { LiveUi.b2b-set-own-deck(i); }
                        }
                    }
                    Action {
                        label: "Encerrar B2B Online";
                        tint: Theme.c-e5484d;
                        clicked => { LiveUi.b2b-cancel(); }
                    }
                }
            }
            // ── FIM B2B ONLINE ─────────────────────────────────────────────
            HorizontalLayout {
                spacing: 8px;
                a := Field {
                    horizontal-stretch: 1;
                    text: LiveUi.dj-a;
                    placeholder: LiveUi.b2b ? "Nome do DJ A" : "Nome do DJ";
                    edited(t) => { LiveUi.set-names(t, b.text); }
                }
                b := Field {
                    horizontal-stretch: 1;
                    visible: LiveUi.b2b;
                    text: LiveUi.dj-b;
                    placeholder: "Nome do DJ B";
                    edited(t) => { LiveUi.set-names(a.text, t); }
                }
            }
            Text {
                text: "Aponte a câmera dos celulares para os QR codes (mesma rede Wi-Fi). Toque em Mostrar detalhes › Visitar o site.";
                color: Theme.text-dim;
                font-size: 10px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                CameraCard {
                    title: LiveUi.b2b ? "Celular 1 · " + LiveUi.dj-a : "Celular 1 · rosto";
                    qr: LiveUi.qr1;
                    url: LiveUi.url1;
                    live: LiveUi.cam1-live;
                    status: LiveUi.cam1-status;
                }
                CameraCard {
                    title: LiveUi.b2b ? "Celular 2 · " + LiveUi.dj-b : "Celular 2 · mãos";
                    qr: LiveUi.qr2;
                    url: LiveUi.url2;
                    live: LiveUi.cam2-live;
                    status: LiveUi.cam2-status;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "TROCA DE CÂMERA"; vertical-alignment: center; }
                Choice {
                    choices: ["8 compassos", "16", "32"];
                    chosen: LiveUi.rotate-bars <= 8 ? 0 : LiveUi.rotate-bars <= 16 ? 1 : 2;
                    picked(i) => { LiveUi.set-rotate(i == 0 ? 8 : i == 1 ? 16 : 32); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "CENA"; vertical-alignment: center; }
                Choice {
                    choices: LiveUi.b2b ? ["Automático", LiveUi.dj-a, LiveUi.dj-b, "Os dois"] : ["Automático", "Rosto", "Mãos"];
                    chosen: LiveUi.manual + 1;
                    picked(i) => { LiveUi.pick(i - 1); }
                }
            }
            EdgeLine { line-color: Theme.border; }
            HorizontalLayout {
                spacing: 10px;
                Switch { on: LiveUi.stream; toggled(on) => { LiveUi.set-stream(on); } }
                Text { text: "Transmitir ao vivo"; color: Theme.text; font-size: 12px; vertical-alignment: center; }
            }
            if LiveUi.stream: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "DESTINO"; vertical-alignment: center; }
                    Choice {
                        choices: ["TikTok", "Instagram", "YouTube"];
                        chosen: LiveUi.platform;
                        picked(i) => { LiveUi.set-platform(i); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "FORMATO"; vertical-alignment: center; }
                    Choice {
                        choices: ["📱 9:16 (Vertical)", "🖥 16:9 (Horizontal)"];
                        chosen: LiveUi.orientation;
                        picked(i) => { LiveUi.set-orientation(i); }
                    }
                }
                Field {
                    text: LiveUi.server;
                    placeholder: LiveUi.platform == 2 ? "rtmp://a.rtmp.youtube.com/live2/" : LiveUi.platform == 1 ? "rtmps://live-upload.instagram.com:443/rtmp/" : "rtmp://push.tiktok.com/live/";
                    edited(t) => { LiveUi.set-server(t); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Field {
                        horizontal-stretch: 1;
                        text: LiveUi.key;
                        secret: true;
                        placeholder: "Chave de transmissão (" + (LiveUi.platform == 2 ? "YouTube" : LiveUi.platform == 1 ? "Instagram" : "TikTok") + ")";
                        edited(t) => { LiveUi.set-key(t); }
                    }
                    Action {
                        width: 75px;
                        height: 26px;
                        border-radius: Theme.radius;
                        label: "📋 Colar";
                        filled: false;
                        clicked => { LiveUi.paste-key(); }
                    }
                }
                if LiveUi.key-status != "": Text {
                    text: LiveUi.key-status;
                    color: Theme.c-30d158;
                    font-size: 11px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: LiveUi.platform == 2 ?
                        "YouTube: no YouTube Studio → Criar → Transmitir ao vivo → copie a Chave (openDJ detecta ao copiar!)." :
                        LiveUi.platform == 1 ?
                        "Instagram: acesse instagram.com/live/producer e copie a chave (openDJ detecta em automático!)." :
                        "TikTok: no app TikTok → + → Live → Stream de PC ou live.tiktok.com/studio.";
                    color: Theme.text-dim;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Switch { on: LiveUi.record; toggled(on) => { LiveUi.set-record(on); } }
                Text { text: "Gravar em " + LiveUi.record-folder; color: Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
            }
            // ── LICENÇA & PRODUTO COMERCIAL (COLAPSÁVEL) ────
            Rectangle {
                background: Theme.panel-raised;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Label { text: "LICENÇA"; vertical-alignment: center; }
                        Rectangle {
                            background: LiveUi.license-active ? Theme.c-30d158.with-alpha(0.18) : Theme.automix.with-alpha(0.18);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px; padding-top: 1px; padding-bottom: 1px;
                                Text {
                                    text: LiveUi.license-active ? "PRO ATIVADO" : "TESTES LIBERADOS";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: LiveUi.license-active ? Theme.c-30d158 : Theme.automix;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: show-license ? "Ocultar ▴" : "Configurar chave ▾";
                            color: Theme.accent;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { show-license = !show-license; }
                        }
                    }
                    if show-license: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "ID desta máquina:"; color: Theme.text-dim; font-size: 10px; }
                                Text { text: LiveUi.license-machine-id; color: Theme.text; font-size: 11px; font-weight: 600; }
                            }
                            Action {
                                width: 80px;
                                height: 26px;
                                font-size: 11px;
                                label: "Copiar ID";
                                filled: false;
                                clicked => { LiveUi.license-copy-machine-id(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            lic-field := Field {
                                horizontal-stretch: 1;
                                text: LiveUi.license-input-key;
                                placeholder: "Colar chave de ativação...";
                                edited(t) => { LiveUi.license-input-key = t; }
                            }
                            Action {
                                width: 90px;
                                height: 26px;
                                font-size: 11px;
                                label: "Validar";
                                filled: false;
                                clicked => { LiveUi.license-validate-key(lic-field.text); }
                            }
                        }
                        if LiveUi.license-feedback-msg != "": Text {
                            text: LiveUi.license-feedback-msg;
                            color: LiveUi.license-active ? Theme.c-30d158 : Theme.text-dim;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if LiveUi.ffmpeg-missing: Text {
                text: "⚠ ffmpeg não encontrado. Cole no Terminal:  brew install ffmpeg";
                color: Theme.c-e5484d;
                font-size: 11px;
                wrap: word-wrap;
            }
            if LiveUi.error != "": Text {
                text: LiveUi.error;
                color: Theme.c-e5484d;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                if !LiveUi.on-air: Action {
                    horizontal-stretch: 1;
                    height: 32px;
                    label: LiveUi.stream ? "Entrar ao vivo" : "Começar a gravar";
                    tint: #fe2c55;
                    clicked => { LiveUi.go(); }
                }
                if LiveUi.on-air: Action {
                    horizontal-stretch: 1;
                    height: 32px;
                    label: "Encerrar · " + LiveUi.time;
                    tint: #fe2c55;
                    clicked => { LiveUi.stop(); }
                }
                if !LiveUi.on-air: Action {
                    width: 115px;
                    height: 32px;
                    font-size: 11px;
                    label: "Desligar câmeras";
                    filled: false;
                    clicked => { LiveUi.finish(); }
                }
                Action {
                    width: 95px;
                    height: 32px;
                    font-size: 11px;
                    label: "Ocultar painel";
                    filled: false;
                    clicked => { root.close(); }
                }
            }
            Text {
                text: "💡 Ao ocultar o painel, a transmissão e as câmeras continuam rodando normalmente.";
                color: Theme.text-dim;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
        // What the audience sees.
        VerticalLayout {
            spacing: 6px;
            Label { text: "O QUE O PÚBLICO VÊ"; }
            Rectangle {
                width: 200px;
                height: LiveUi.orientation == 1 ? 112px : 355px;
                border-radius: 10px;
                background: #0b0b0e;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                Image { source: LiveUi.preview; width: 200px; height: LiveUi.orientation == 1 ? 112px : 355px; image-fit: contain; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { LiveUi.toggle-projector(); }
                }
            }
            Action {
                width: 200px;
                height: 28px;
                font-size: 11px;
                label: LiveUi.projector-open ? "Fechar janela (Projetor)" : "Abrir janela (Projetor / OBS)";
                tint: LiveUi.projector-open ? Theme.accent : Theme.control;
                filled: LiveUi.projector-open;
                clicked => { LiveUi.toggle-projector(); }
            }
            Text { text: LiveUi.shot; color: Theme.text-dim; font-size: 10px; width: 200px; wrap: word-wrap; }
            if LiveUi.on-air: Text { text: LiveUi.health; color: Theme.text-dim; font-size: 10px; width: 200px; wrap: word-wrap; }
        }
    }
}

// The top bar button: LIVE, red with the time while on air.
export component LiveButton inherits Rectangle {
    property <bool> on: LiveUi.on-air;
    property <color> tint: #fe2c55;
    background: ta.pressed ? Theme.control-pressed : on ? tint.with-alpha(0.16) : ta.has-hover ? Theme.n-2e2e32 : Theme.panel-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: on ? tint : LiveUi.started ? Theme.lilac : transparent;
    height: 36px;
    y: 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        LiveIcon {
            y: (parent.height - self.height) / 2;
            ink: on ? tint : Theme.text-dim;
            opacity: on && mod(animation-tick() / 1ms, 1000) > 600 ? 0.4 : 1.0;
        }
        Text {
            text: on ? LiveUi.time : "LIVE";
            color: on ? Theme.text : Theme.text-dim;
            font-size: on ? 13px : 11px;
            font-weight: on ? 500 : 700;
            letter-spacing: on ? 0px : 0.5px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            LiveUi.opened();
            panel.show();
        }
    }
    panel := LivePanel {
        x: root.width - self.width;
        y: root.height + 6px;
    }
}
