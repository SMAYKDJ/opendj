// Settings › APC Key 25: a picture of the Akai APC Key 25 mk2 seen from
// above, its 40 pads lit live as the controller lights them. The top row
// follows deck 1's phrase, the second deck 2's, each filling from the right
// one pad at a time (see src/apc_pads.rs).

import { Theme } from "theme.slint";

export global ApcPads {
    // Whether the top rows show the phrases.
    in property <bool> on: true;
    // Pads already played show dimmer than the one playing.
    in property <bool> trail: true;
    // Each deck's colour.
    in property <[color]> colors: [#2fd45a, #2f6bff];
    // Pads lit in each deck's row, 0 to 8.
    in property <[int]> lit: [0, 0];
}

// One pad: dark grey off, its deck's colour lit; dimmer for a trail pad.
component Pad inherits Rectangle {
    in property <color> lit-color;
    // 0 off, 1 lit dim (trail), 2 lit full.
    in property <int> level;
    width: 34px;
    height: 22px;
    border-radius: 3px;
    background: level == 2 ? lit-color : level == 1 ? lit-color.with-alpha(0.38) : #3a3a3e;
    drop-shadow-blur: level == 2 ? 10px : 0px;
    drop-shadow-color: lit-color.with-alpha(0.7);
    animate background { duration: 60ms; }
}

export component ApcPicture inherits Rectangle {
    width: 560px;
    height: 330px;
    border-radius: 10px;
    background: #1b1b1d;
    border-width: 3px;
    border-color: #d4301f;

    // Row r (0 the top), pad p (0 the left).
    function level(r: int, p: int) -> int {
        if !ApcPads.on || r > 1 { return 0; }
        // Pads fill from the right: the rightmost is the first.
        if 8 - p > ApcPads.lit[r] { return 0; }
        if 8 - p == ApcPads.lit[r] || !ApcPads.trail { return 2; }
        return 1;
    }

    // The 5 × 8 pads.
    for r in 5: HorizontalLayout {
        x: 24px;
        y: 22px + r * 30px;
        spacing: 6px;
        for p in 8: Pad {
            level: root.level(r, p);
            lit-color: ApcPads.colors[min(r, 1)];
        }
    }
    // Which deck each row is.
    for r in 2: Text {
        x: 7px;
        y: 22px + r * 30px + 4px;
        text: r == 0 ? "1" : "2";
        color: ApcPads.colors[r];
        font-size: 11px;
        font-weight: 700;
    }
    // The soft keys right of the pads.
    for r in 5: Rectangle {
        x: 352px;
        y: 26px + r * 30px;
        width: 22px;
        height: 14px;
        border-radius: 2px;
        background: #4a4a4e;
    }
    // The track buttons under the pads.
    for p in 8: Rectangle {
        x: 24px + p * 40px + 6px;
        y: 178px;
        width: 22px;
        height: 12px;
        border-radius: 2px;
        background: #b8463c;
    }
    // The eight knobs.
    for k in 8: Rectangle {
        x: 396px + mod(k, 4) * 40px;
        y: 30px + floor(k / 4) * 52px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: #0c0c0d;
        border-width: 2px;
        border-color: #2c2c30;
    }
    Text {
        x: 420px;
        y: 150px;
        text: "AKAI";
        color: #f0f0f0;
        font-size: 18px;
        font-weight: 800;
    }
    Text {
        x: 420px;
        y: 172px;
        text: "APC KEY 25";
        color: #f0f0f0;
        font-size: 11px;
        font-weight: 700;
    }
    // The keys.
    for k in 15: Rectangle {
        x: 18px + k * 35px;
        y: 206px;
        width: 33px;
        height: 110px;
        border-radius: 3px;
        background: #f4f4f4;
    }
    for k in 15: Rectangle {
        // Black keys after each white key but the third and seventh of an octave.
        visible: mod(k, 7) != 2 && mod(k, 7) != 6 && k < 14;
        x: 18px + k * 35px + 23px;
        y: 206px;
        width: 22px;
        height: 66px;
        border-radius: 2px;
        background: #141414;
    }
}
